# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing a real API key.

# Required. Enquiry form submissions are sent as email via Resend
# (https://resend.com). Create a key in the Resend dashboard and set the
# same value in Vercel under Project Settings → Environment Variables for
# Production, Preview, and Development.
RESEND_API_KEY=

# Optional. Overrides the default Resend sending address once CHUBZ MOTORS
# has verified a sending domain in Resend. Format: "Name <email@domain>".
# Falls back to Resend's shared test sender (onboarding@resend.dev) if unset,
# which works without domain verification but is only meant for testing.
RESEND_FROM_EMAIL=
